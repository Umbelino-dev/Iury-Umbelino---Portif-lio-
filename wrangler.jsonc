{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio", // must match the Worker connected in Cloudflare (Workers Builds refuses a mismatch)
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script runs. `npm run build` writes ./out.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
